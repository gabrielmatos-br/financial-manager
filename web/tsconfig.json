{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "vite.config.ts"],
	"types": ["node", "vite/client"]
}
